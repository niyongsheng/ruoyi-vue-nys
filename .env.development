# 开发环境配置（vite serve 默认加载，对应 pnpm dev）
# 公共配置见 .env

VITE_APP_ENV = 'development'

# 开发环境：前端请求走 vite 代理（见 build/config/proxy.ts）
VITE_APP_BASE_API = '/dev-api'

# 本地联调
# VITE_PROXY_TARGET = http://localhost:8080
# 若依官方演示API
VITE_PROXY_TARGET = http://vue.ruoyi.vip/prod-api

# 开启 vite 代理 + 代理日志
VITE_HTTP_PROXY = Y
VITE_PROXY_LOG = Y
